APP_NAME=UIST2its
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://change-me.onrender.com
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
# Replace with the Render PostgreSQL Internal Database URL; do not commit credentials.
DB_URL=postgresql://USER:change-moi@HOST:5432/DATABASE?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Notifications implement ShouldQueue. "sync" processes them in the web request;
# switch to "database" only when a Render worker service is configured.
QUEUE_CONNECTION=sync

# Configure a real SMTP provider if publication emails are required.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=change-me.smtp.example
MAIL_PORT=587
MAIL_USERNAME=change-moi
MAIL_PASSWORD=change-moi
MAIL_FROM_ADDRESS=notifications@example.invalid
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=public

# Leave empty to generate a one-time random admin password during db:seed.
ADMIN_INITIAL_PASSWORD=
UIST_ADMISSION_AVERAGE=10
UIST_STUDENT_LOGIN_ATTEMPTS=5
UIST_STUDENT_LOGIN_DECAY_MINUTES=1
UIST_SOCIAL_X=https://example.invalid/x
UIST_SOCIAL_GOOGLE=https://example.invalid/google
UIST_SOCIAL_PINTEREST=https://example.invalid/pinterest
UIST_SOCIAL_FACEBOOK=https://example.invalid/facebook
